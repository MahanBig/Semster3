# Mal for hemmelige verdier til docker-compose.yml.
# Kopier denne filen til .env (i samme mappe) og bytt ut verdiene. .env ligger i .gitignore og havner aldri i Git.

# Passord til den første admin-brukeren (admin@heimevernet.local).
# Må ha minst 8 tegn, stor og liten bokstav, et tall og et spesialtegn, ellers starter ikke appen.
ADMIN_PASSWORD=EtSterktPassord1!

# Valgfritt: e-post til admin-brukeren (standard er admin@heimevernet.local).
# ADMIN_EMAIL=admin@heimevernet.local

# Valgfritt: root-passord til MariaDB (standard er heimevernet-dev). Bare for lokal utvikling.
# MARIADB_ROOT_PASSWORD=heimevernet-dev
