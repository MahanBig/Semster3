<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>heimevernet-web-58bfd5ea-4379-4c76-bb83-e242f18d9e33</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="leaflet" Version="0.7.3" />
    <!-- Dapper: kjører SQL-en vi skriver selv og gjør om radene til C#-objekter. -->
    <PackageReference Include="Dapper" Version="2.1.66" />
    <!-- MySqlConnector: selve koblingen ("driveren") til MariaDB/MySQL. -->
    <PackageReference Include="MySqlConnector" Version="2.4.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- SQL-skriptet som lager tabellene bakes inn i programfilen (.dll), så det alltid er med, også i Docker. -->
    <None Remove="DataAccess\Sql\Schema.sql" />
    <EmbeddedResource Include="DataAccess\Sql\Schema.sql" LogicalName="Heimevernet.Web.Schema.sql" />
  </ItemGroup>

</Project>
