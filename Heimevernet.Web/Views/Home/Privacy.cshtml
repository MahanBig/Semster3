@{
    ViewData["Title"] = "Personvern";
}

<section class="panel d-flex flex-column gap-3" style="max-width: 760px">
    <h1 class="m-0">Personvern</h1>
    <p class="m-0">Dette lagrer Beredskapskart om deg:</p>
    <ul class="m-0">
        <li><strong>Brukerkonto:</strong> e-postadressen din og en kryptert versjon (hash) av passordet. Selve passordet lagres aldri.</li>
        <li><strong>Posisjoner du melder inn:</strong> punktet på kartet, beskrivelsen, e-postadressen din og tidspunktet. Dette er synlig for alle som besøker siden.</li>
        <li><strong>Innloggingscookie:</strong> en nødvendig informasjonskapsel som husker at du er logget inn.</li>
    </ul>
    <p class="m-0">Kartet hentes fra OpenStreetMap, og adresser slås opp hos OpenStreetMap Nominatim. Nettleseren din kontakter dem direkte.</p>
</section>
