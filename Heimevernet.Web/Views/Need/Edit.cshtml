@using Heimevernet.Web.Models.ViewModels.Need
@model NeedViewModel
@{
    ViewData["Title"] = "Endre " + Model.Title;
    ViewData["SubmitText"] = "Lagre endringer";
}

<a asp-action="Details" asp-route-id="@Model.Id" class="back-link">
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 5l-7 7 7 7"></path></svg>
    Avbryt
</a>

<h1 class="m-0">Endre behov</h1>

<form asp-action="Edit" asp-route-id="@Model.Id" method="post" class="panel-grid">
    <partial name="_NeedForm" model="Model" />
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        $.validator.setDefaults({ ignore: [] });
    </script>
}
