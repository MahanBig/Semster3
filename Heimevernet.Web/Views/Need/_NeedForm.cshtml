@using Heimevernet.Web.Models.ViewModels.Need
@using Microsoft.AspNetCore.Mvc.Rendering
@model NeedViewModel
@{
    var organizations = ViewData["Organizations"] as SelectList;
}
@* Brukes av Create.cshtml og Edit.cshtml. *@
<div class="panel d-flex flex-column gap-4">
    <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>

    <fieldset>
        <legend class="mb-3">Hva trengs?</legend>
        <div class="chip-row">
            @foreach (var category in ResourceCategory.All)
            {
                var id = $"category-{category.Key}";
                <input type="radio" class="chip-radio" id="@id" asp-for="Category" value="@category.Label" />
                <label class="chip" for="@id" style="--chip-color: @category.Color">@Html.Raw(category.IconSvg(18, 2.3))@category.Label</label>
            }
        </div>
        <span asp-validation-for="Category" class="text-danger"></span>
    </fieldset>

    <div>
        <label asp-for="Title" class="form-label"></label>
        <input asp-for="Title" class="form-control" placeholder="F.eks. Drikkevann til sykehjemmet" />
        <span asp-validation-for="Title" class="text-danger"></span>
    </div>
    <div>
        <label asp-for="Description" class="form-label"></label>
        <div id="need-desc-hint" class="form-text mb-2">Hva trengs, til hvem, og hvordan skal det leveres?</div>
        <textarea asp-for="Description" class="form-control" rows="5" aria-describedby="need-desc-hint"></textarea>
        <span asp-validation-for="Description" class="text-danger"></span>
    </div>
    <div class="row g-3">
        <div class="col-5">
            <label asp-for="Quantity" class="form-label"></label>
            <input asp-for="Quantity" class="form-control" type="number" min="1" inputmode="numeric" />
            <span asp-validation-for="Quantity" class="text-danger"></span>
        </div>
        <div class="col-7">
            <label asp-for="Priority" class="form-label"></label>
            <select asp-for="Priority" class="form-select form-control">
                @foreach (var priority in NeedPriority.All)
                {
                    <option value="@priority">@NeedPriority.Label(priority)</option>
                }
            </select>
            <span asp-validation-for="Priority" class="text-danger"></span>
        </div>
    </div>
</div>

<div class="panel d-flex flex-column gap-4">
    <div>
        <label asp-for="Deadline" class="form-label">Frist <span class="optional">(valgfritt)</span></label>
        <input asp-for="Deadline" class="form-control" type="date" />
        <span asp-validation-for="Deadline" class="text-danger"></span>
    </div>
    <div>
        <label asp-for="OrganizationId" class="form-label">Organisasjon <span class="optional">(valgfritt)</span></label>
        <select asp-for="OrganizationId" asp-items="organizations" class="form-select form-control">
            <option value="">Ingen, jeg melder det inn selv</option>
        </select>
        <span asp-validation-for="OrganizationId" class="text-danger"></span>
    </div>
    <div>
        <label asp-for="Address" class="form-label">Hvor trengs det? <span class="optional">(valgfritt)</span></label>
        <input asp-for="Address" class="form-control" autocomplete="street-address" />
        <span asp-validation-for="Address" class="text-danger"></span>
    </div>
    <div class="row g-3">
        <div class="col-5">
            <label asp-for="PostalCode" class="form-label"></label>
            <input asp-for="PostalCode" class="form-control" inputmode="numeric" autocomplete="postal-code" />
            <span asp-validation-for="PostalCode" class="text-danger"></span>
        </div>
        <div class="col-7">
            <label asp-for="PostalPlace" class="form-label"></label>
            <input asp-for="PostalPlace" class="form-control" autocomplete="address-level2" />
            <span asp-validation-for="PostalPlace" class="text-danger"></span>
        </div>
    </div>
    <button type="submit" class="btn-pill btn-pill-block">@(ViewData["SubmitText"] ?? "Lagre")</button>
</div>
