@using System.Globalization
@using Heimevernet.Web.Models.ViewModels.Resource
@model ResourceViewModel
@{
    ViewData["Title"] = Model.Name;
    var category = ResourceCategory.FromType(Model.Category);
    // "Storgata 1, 4790 Lillesand" – tomme deler hoppes over.
    var place = $"{Model.PostalCode} {Model.PostalPlace}".Trim();
    var fullAddress = string.Join(", ", new[] { Model.Address, place }.Where(part => !string.IsNullOrWhiteSpace(part)));
    // Punktet med punktum som desimaltegn, til kartet og lenken til OpenStreetMap.
    var lat = Model.Latitude?.ToString("0.######", CultureInfo.InvariantCulture);
    var lng = Model.Longitude?.ToString("0.######", CultureInfo.InvariantCulture);
    var mapLink = Model.HasPosition
        ? $"https://www.openstreetmap.org/?mlat={lat}&mlon={lng}#map=16/{lat}/{lng}"
        : fullAddress.Length > 0 ? $"https://www.openstreetmap.org/search?query={Uri.EscapeDataString(fullAddress)}" : null;
}

<a asp-controller="ResourceHandler" asp-action="Index" class="back-link">
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 5l-7 7 7 7"></path></svg>
    Tilbake til ressurser
</a>

@if (TempData["Message"] is string message)
{
    <div class="alert alert-success" role="status">@message</div>
}

<div class="panel-grid">
    <article class="panel-wide d-flex flex-column gap-4">
        @if (Model.HasImage)
        {
            <img class="detail-hero detail-hero--image" src="@Url.Action("Image", "Resource", new { id = Model.Id })" alt="Bilde av @Model.Name" />
        }
        else
        {
            <div class="detail-hero" style="background: @category.Tint; color: @category.Color" aria-hidden="true">
                @Html.Raw(category.IconSvg(96, 1.4))
            </div>
        }

        <div class="d-flex flex-column gap-3">
            <span class="badge-category" style="background: @category.Tint; color: @category.Color">
                @Html.Raw(category.IconSvg(16, 2.4))@category.Label
            </span>
            <h1 class="m-0">@Model.Name</h1>
            <div class="d-flex flex-wrap gap-2">
                <span class="status-pill">@ResourceStatus.Label(Model.Status)</span>
                <span class="status-pill fw-normal">Antall: @Model.Quantity</span>
                @if (!string.IsNullOrEmpty(Model.OwnerName))
                {
                    <span class="status-pill fw-normal">Lagt inn av @Model.OwnerName</span>
                }
            </div>
            @* Knappene vises bare for eier og admin. Controlleren sjekker det samme igjen ved endring og sletting. *@
            @if (Model.CanModify)
            {
                <div class="d-flex flex-wrap gap-2">
                    <a asp-controller="ResourceHandler" asp-action="Edit" asp-route-id="@Model.Id" class="btn-pill btn-pill-outline btn-pill-small">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 20h4l10.5-10.5a2.8 2.8 0 0 0-4-4L4 16z"></path></svg>
                        Endre
                    </a>
                    <a asp-controller="ResourceHandler" asp-action="Delete" asp-route-id="@Model.Id" class="btn-pill btn-pill-danger-outline btn-pill-small">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 7h16M10 11v6M14 11v6M6 7l1 13h10l1-13M9 7V4h6v3"></path></svg>
                        Slett
                    </a>
                </div>
            }
        </div>

        <section class="panel">
            <h2>Om ressursen</h2>
            <p class="m-0" style="font-size: 18px; line-height: 1.6; color: var(--text-2); max-width: 68ch">@Model.Description</p>
        </section>
    </article>

    <aside class="panel-narrow d-flex flex-column gap-3">
        <section class="panel">
            <h2>Plassering</h2>
            @if (Model.HasPosition)
            {
                @* Lite kart med punktet. data-* leses av skriptet nederst. *@
                <div class="detail-map" id="detail-map" role="img" aria-label="Kart som viser hvor ressursen er"
                     data-lat="@lat" data-lng="@lng" data-color="@category.Color" data-icon="@category.IconPath"></div>
                <p class="location-line mt-2 mb-0" data-location-status>
                    <span data-location-text></span>
                    <button type="button" class="link-button" data-use-location>Bruk min posisjon</button>
                </p>
                <p class="mt-1 mb-0 fw-bold" id="detail-distance" hidden></p>
            }
            @if (fullAddress.Length > 0)
            {
                <dl class="facts">
                    <div><dt>Adresse</dt><dd>@fullAddress</dd></div>
                </dl>
            }
            @if (mapLink is not null)
            {
                <a class="btn-pill btn-pill-block mt-3" target="_blank" rel="noopener" href="@mapLink">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 11l18-8-8 18-2-8z"></path></svg>
                    Finn i kart
                    <span class="visually-hidden">(åpnes i ny fane)</span>
                </a>
            }
            else
            {
                <p class="m-0 text-muted">Adressen er ikke registrert.</p>
            }
        </section>

        <section class="panel">
            <h2>Kontakt</h2>
            @if (!string.IsNullOrEmpty(Model.OwnerPhone))
            {
                <p class="mb-3">Eiers telefon: <strong>@Model.OwnerPhone</strong></p>
                <a class="btn-pill btn-pill-outline btn-pill-block" href="tel:@Model.OwnerPhone">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2"></path></svg>
                    Ring eier
                </a>
            }
            else
            {
                <p class="m-0 text-muted">Ingen kontaktinformasjon er registrert.</p>
            }
        </section>
    </aside>
</div>

@section Scripts {
    @if (Model.HasPosition)
    {
        <script>
            (function () {
                var element = document.getElementById('detail-map');
                var lat = parseFloat(element.dataset.lat), lng = parseFloat(element.dataset.lng);
                var map = L.map(element, { scrollWheelZoom: false }).setView([lat, lng], 15);
                beredskapTiles(map);
                L.marker([lat, lng], { icon: kriseklarMarkerIcon(element.dataset.color, element.dataset.icon), keyboard: false }).addTo(map);

                // Avstand fra brukeren, regnet ut i nettleseren.
                var distance = document.getElementById('detail-distance');
                function show(position) {
                    if (!position) { distance.hidden = true; return; }
                    var meters = map.distance([position.lat, position.lng], [lat, lng]);
                    distance.textContent = (meters < 1000 ? Math.round(meters / 10) * 10 + ' m' : String(Math.round(meters / 100) / 10).replace('.', ',') + ' km') + ' unna deg';
                    distance.hidden = false;
                }
                kriseklarPosition.onChange(show);
                show(kriseklarPosition.get());
            })();
        </script>
    }
}
