@using Heimevernet.Web.Models.ViewModels.Resource
@model ResourceViewModel
@{
    ViewData["Title"] = "Ny ressurs";
    ViewData["SubmitText"] = "Lagre ressurs";
}

<div class="form-head">
    <h1 class="m-0">Meld inn en ressurs</h1>
    <a asp-action="Index" class="btn-pill btn-pill-outline btn-pill-small">Avbryt</a>
</div>

@* enctype="multipart/form-data" trengs for å sende med bildefilen. *@
<form asp-action="Create" method="post" enctype="multipart/form-data" class="resource-form">
    <partial name="_ResourceForm" model="Model" />
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        // Radioknappene er skjult (vi viser "chips" i stedet), så de må ikke hoppes over av valideringen.
        $.validator.setDefaults({ ignore: [] });
    </script>
}
