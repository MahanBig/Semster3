@using Heimevernet.Web.Models.ViewModels.Resource
@model ResourceViewModel
@{
    ViewData["Title"] = "Endre " + Model.Name;
    ViewData["SubmitText"] = "Lagre endringer";
}

<a asp-controller="Resource" asp-action="Index" asp-route-id="@Model.Id" class="back-link">
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 5l-7 7 7 7"></path></svg>
    Avbryt
</a>

<h1 class="m-0">Endre ressurs</h1>

@* asp-route-id gir /ResourceHandler/Edit/5, så controlleren vet hvilken ressurs som endres. *@
<form asp-action="Edit" asp-route-id="@Model.Id" method="post" enctype="multipart/form-data" class="panel-grid">
    <partial name="_ResourceForm" model="Model" />
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        $.validator.setDefaults({ ignore: [] });
    </script>
}
