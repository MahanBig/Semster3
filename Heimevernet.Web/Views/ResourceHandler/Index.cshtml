@using Heimevernet.Web.Models.ViewModels.Resource
@model List<ResourceViewModel>
@{
    ViewData["Title"] = "Ressurser";
    ViewData["ShowDescription"] = true; // Kortene på denne siden viser også beskrivelsen.
}

<div class="page-head">
    <h1>Ressurser</h1>
    @if (User.IsInRole(AppRoles.Admin))
    {
        <a asp-action="Create" class="btn-pill btn-pill-small">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" aria-hidden="true"><path d="M12 5v14M5 12h14"></path></svg>
            Ny ressurs
        </a>
    }
</div>

@if (Model.Count == 0)
{
    <p class="panel empty-state">Ingen ressurser er registrert ennå.</p>
}
else
{
    <section data-resource-filter class="d-flex flex-column gap-3" aria-label="Søk og filtrer ressurser">
        <label class="search-pill">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7"></circle><path d="M20 20l-3.5-3.5"></path></svg>
            <input type="search" data-filter-search aria-label="Søk etter ressurs" placeholder="Søk etter navn, type eller beskrivelse" />
        </label>
        <partial name="_CategoryChips" />

        <p class="m-0 fw-bold" data-filter-count aria-live="polite">@Model.Count steder</p>

        <ul class="resource-grid">
            @foreach (var resource in Model)
            {
                <partial name="_ResourceItem" model="resource" />
            }
        </ul>
        <p class="panel empty-state" data-filter-empty hidden>Ingen ressurser passer søket. Prøv et annet ord eller fjern filtrene.</p>
    </section>
}
