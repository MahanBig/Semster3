@using Heimevernet.Web.Models.ViewModels.Resource
@model ResourceViewModel
@* Feltene for en ressurs. Brukes av både Create.cshtml og Edit.cshtml, så skjemaet er likt begge steder.
   Selve <form> ligger i viewene, fordi de sender til ulike actions. *@
<div class="panel d-flex flex-column gap-4">
    <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>

    @* Kategoriene fra designet som radioknapper. Verdien lagres i Type. *@
    <fieldset>
        <legend class="mb-3">Hva slags ressurs er det?</legend>
        <div class="chip-row">
            @foreach (var category in ResourceCategory.All)
            {
                var id = $"type-{category.Key}";
                <input type="radio" class="chip-radio" id="@id" asp-for="Type" value="@category.Label" />
                <label class="chip" for="@id" style="--chip-color: @category.Color">@Html.Raw(category.IconSvg(18, 2.3))@category.Label</label>
            }
            @* En eldre ressurs kan ha en type som ikke er en av kategoriene (f.eks. "Type A"). Den vises som eget valg, så den ikke forsvinner ved endring. *@
            @if (!string.IsNullOrWhiteSpace(Model.Type) && !ResourceCategory.All.Any(c => c.Label == Model.Type))
            {
                <input type="radio" class="chip-radio" id="type-existing" asp-for="Type" value="@Model.Type" />
                <label class="chip" for="type-existing">@Model.Type</label>
            }
        </div>
        <span asp-validation-for="Type" class="text-danger"></span>
    </fieldset>

    <div>
        <label asp-for="Name" class="form-label">Navn på stedet</label>
        <input asp-for="Name" class="form-control" placeholder="F.eks. Vannpost ved Kampen kirke" />
        <span asp-validation-for="Name" class="text-danger"></span>
    </div>
    <div>
        <label asp-for="Description" class="form-label"></label>
        <div id="desc-hint" class="form-text mb-2">Hva finnes her, og hva bør folk ta med?</div>
        <textarea asp-for="Description" class="form-control" rows="5" aria-describedby="desc-hint"></textarea>
        <span asp-validation-for="Description" class="text-danger"></span>
    </div>
</div>

<div class="panel d-flex flex-column gap-4">
    <div>
        <label asp-for="Address" class="form-label">Adresse <span class="optional">(valgfritt)</span></label>
        <input asp-for="Address" class="form-control" autocomplete="street-address" />
        <span asp-validation-for="Address" class="text-danger"></span>
    </div>
    <div class="row g-3">
        <div class="col-5">
            <label asp-for="ZipCode" class="form-label">Postnummer</label>
            <input asp-for="ZipCode" class="form-control" inputmode="numeric" autocomplete="postal-code" />
            <span asp-validation-for="ZipCode" class="text-danger"></span>
        </div>
        <div class="col-7">
            <label asp-for="City" class="form-label">Poststed</label>
            <input asp-for="City" class="form-control" autocomplete="address-level2" />
            <span asp-validation-for="City" class="text-danger"></span>
        </div>
    </div>
    <div>
        <label asp-for="OwnerTelephoneNumber" class="form-label">Eiers telefon <span class="optional">(valgfritt)</span></label>
        <input asp-for="OwnerTelephoneNumber" class="form-control" type="tel" autocomplete="tel" />
        <span asp-validation-for="OwnerTelephoneNumber" class="text-danger"></span>
    </div>
    <button type="submit" class="btn-pill btn-pill-block">@(ViewData["SubmitText"] ?? "Lagre")</button>
</div>
