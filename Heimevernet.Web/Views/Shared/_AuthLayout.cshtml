@{
    // Delt skjerm for innlogging og registrering, som i designet: mørk side med info, lys side med skjema.
}
<!DOCTYPE html>
<html lang="no">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] – KriseKlar</title>
    <link rel="icon" type="image/svg+xml" href="~/img/kriseklar.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Atkinson+Hyperlegible:wght@400;700&display=swap" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <div class="auth">
        <section class="auth-hero">
            <a class="brand" asp-controller="Home" asp-action="Index">
                <img class="brand-mark" src="~/img/kriseklar.svg" alt="" />
                KriseKlar
            </a>
            <div class="auth-hero-body">
                <h1>Finn hjelp nær deg når noe skjer.</h1>
                <ul class="check-list">
                    <li><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12l5 5 9-10"></path></svg>Se mat, vann, ly, helse og verktøy på ett sted</li>
                    <li><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12l5 5 9-10"></path></svg>Meld inn ressurser og behov når du er logget inn</li>
                    <li><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12l5 5 9-10"></path></svg>Logg inn for å se kartet og alle ressursene</li>
                </ul>
            </div>
            <section class="emergency-inline" aria-label="Nødnumre">
                <span>Akutt fare? Ring nødnummer</span>
                <a href="tel:110"><strong>110</strong> Brann</a>
                <a href="tel:112"><strong>112</strong> Politi</a>
                <a href="tel:113"><strong>113</strong> Ambulanse</a>
            </section>
        </section>

        <main class="auth-main" id="main">
            @* Bare på mobil: logoen over skjemaet, siden den blå delen (med nødnumrene) kommer under. *@
            <a class="auth-mobile-brand" asp-controller="Home" asp-action="Index">
                <img src="~/img/kriseklar.svg" alt="" width="32" height="40" />
                KriseKlar
            </a>
            @RenderBody()
        </main>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
