@inject Microsoft.Extensions.Configuration.IConfiguration Configuration
@{
    // Hvilken side vi er på, så riktig menyvalg markeres (aria-current="page").
    var controller = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    var action = ViewContext.RouteData.Values["action"]?.ToString();
    string? Current(string[] controllers, string? onlyAction = null) =>
        controllers.Contains(controller, StringComparer.OrdinalIgnoreCase)
        && (onlyAction is null || string.Equals(action, onlyAction, StringComparison.OrdinalIgnoreCase))
            ? "page" : null;

    // Varselbanneret vises bare for admin, og bare når det er satt i konfigurasjonen (appsettings).
    var alertTitle = Configuration["Beredskap:Varsel:Tittel"];
    var alertText = Configuration["Beredskap:Varsel:Tekst"];
    var fullWidth = ViewData["FullWidth"] is true;
}
<!DOCTYPE html>
<html lang="no">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] – KriseKlar</title>
    <link rel="icon" type="image/svg+xml" href="~/img/kriseklar.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Atkinson+Hyperlegible:wght@400;700&display=swap" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/lib/leaflet/dist/leaflet.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <a href="#main" class="visually-hidden-focusable">Hopp til innholdet</a>

    <div class="app">
        <aside class="sidebar">
            <a class="brand" asp-controller="Home" asp-action="Index">
                <img class="brand-mark" src="~/img/kriseklar.svg" alt="" />
                KriseKlar
            </a>

            <nav aria-label="Hovedmeny">
                <ul class="nav-list">
                    <li>
                        <a asp-controller="Home" asp-action="Index" aria-current="@Current(["Home"], "Index")">
                            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 4L3 6v14l6-2 6 2 6-2V4l-6 2z"></path><path d="M9 4v14M15 6v14"></path></svg>
                            Kart
                        </a>
                    </li>
                    <li>
                        <a asp-controller="ResourceHandler" asp-action="Index" aria-current="@Current(["ResourceHandler", "Resource"])">
                            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7"></circle><path d="M20 20l-3.5-3.5"></path></svg>
                            Ressurser
                        </a>
                    </li>
                    <li>
                        <a asp-controller="Need" asp-action="Index" aria-current="@Current(["Need"])">
                            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 21s-7-4.5-9.5-9A5.5 5.5 0 0 1 12 6a5.5 5.5 0 0 1 9.5 6c-2.5 4.5-9.5 9-9.5 9z"></path></svg>
                            Behov
                        </a>
                    </li>
                    @if (User.IsInRole(AppRoles.Admin))
                    {
                        <li>
                            <a asp-controller="UserAdmin" asp-action="Index" aria-current="@Current(["UserAdmin"])">
                                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="9" cy="8" r="3.5"></circle><path d="M2.5 20c1-3.5 3.5-5.5 6.5-5.5s5.5 2 6.5 5.5"></path><path d="M16 4.5a3.5 3.5 0 0 1 0 7M18 14.8c1.8.8 3 2.6 3.5 5.2"></path></svg>
                                Admin
                            </a>
                        </li>
                    }
                    <li>
                        <a asp-controller="Settings" asp-action="Index" aria-current="@Current(["Settings"])">
                            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="3"></circle><path d="M19.4 15a1.7 1.7 0 0 0 .3 1.8l.1.1a2 2 0 1 1-2.8 2.8l-.1-.1a1.7 1.7 0 0 0-1.8-.3 1.7 1.7 0 0 0-1 1.5V21a2 2 0 1 1-4 0v-.1a1.7 1.7 0 0 0-1.1-1.5 1.7 1.7 0 0 0-1.8.3l-.1.1a2 2 0 1 1-2.8-2.8l.1-.1a1.7 1.7 0 0 0 .3-1.8 1.7 1.7 0 0 0-1.5-1H3a2 2 0 1 1 0-4h.1a1.7 1.7 0 0 0 1.5-1.1 1.7 1.7 0 0 0-.3-1.8l-.1-.1a2 2 0 1 1 2.8-2.8l.1.1a1.7 1.7 0 0 0 1.8.3H9a1.7 1.7 0 0 0 1-1.5V3a2 2 0 1 1 4 0v.1a1.7 1.7 0 0 0 1 1.5 1.7 1.7 0 0 0 1.8-.3l.1-.1a2 2 0 1 1 2.8 2.8l-.1.1a1.7 1.7 0 0 0-.3 1.8V9a1.7 1.7 0 0 0 1.5 1H21a2 2 0 1 1 0 4h-.1a1.7 1.7 0 0 0-1.5 1z"></path></svg>
                            Innstillinger
                        </a>
                    </li>
                </ul>
            </nav>

            <div class="sidebar-spacer"></div>

            <section class="emergency" aria-label="Nødnumre">
                <h2>Akutt fare? Ring</h2>
                <div class="emergency-grid">
                    <a href="tel:110"><strong>110</strong><span>Brann</span></a>
                    <a href="tel:112"><strong>112</strong><span>Politi</span></a>
                    <a href="tel:113"><strong>113</strong><span>Ambulanse</span></a>
                </div>
            </section>

            <partial name="_LoginPartial" />

            <p class="sidebar-footer">
                <a asp-controller="Home" asp-action="Privacy">Personvern</a>
            </p>
        </aside>

        <div class="main">
            @if (User.IsInRole(AppRoles.Admin) && !string.IsNullOrWhiteSpace(alertTitle))
            {
                <div class="crisis-banner" role="status">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3l10 18H2z"></path><path d="M12 10v5M12 18h.01"></path></svg>
                    <span><strong>@alertTitle</strong> @alertText</span>
                </div>
            }

            <main id="main" class="page@(fullWidth ? " page--full" : "")" tabindex="-1">
                @RenderBody()
            </main>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/lib/leaflet/dist/leaflet.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
